{
  "id": "h-guard",
  "name": "h-guard",
  "description": "Checks tool calls, tool output and prompts with h-guard.",
  "activation": { "onStartup": true },
  "contracts": { "agentToolResultMiddleware": ["openclaw"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "notify": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "on": { "type": "array", "items": { "type": "string", "enum": ["deny", "warn", "ask"] } },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["channel", "to"],
              "properties": {
                "channel": { "type": "string", "minLength": 1 },
                "to": { "type": "string", "minLength": 1 },
                "account": { "type": "string", "minLength": 1 },
                "thread": { "type": "string", "minLength": 1 }
              }
            }
          },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
